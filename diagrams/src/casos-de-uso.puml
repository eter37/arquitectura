@startuml casos-de-uso
left to right direction

actor "Usuario\n(conductor/peatón)" as Usuario
actor "Centro de control" as Control
actor "Sistema de sensores" as Sensores
actor "Servicios externos\n(mapas, clima)" as Externos

rectangle "Smart Mobility System" {
  usecase "Consultar ruta óptima" as UC1
  usecase "Recibir alertas de\ncongestión o incidentes" as UC2
  usecase "Monitorear tráfico\nen tiempo real" as UC3
  usecase "Detectar congestión" as UC4
  usecase "Generar alerta" as UC5
  usecase "Gestionar semáforos" as UC6
  usecase "Consultar datos de\nmapas y clima" as UC7
  usecase "Administrar usuarios\ndel sistema" as UC8
}

Usuario --> UC1
Usuario --> UC2
Sensores --> UC3
UC3 ..> UC4 : <<include>>
UC4 ..> UC5 : <<include>>
Control --> UC6
Control --> UC8
UC1 ..> UC7 : <<include>>
Externos --> UC7

@enduml